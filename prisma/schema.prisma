// سينوفا إنترناشيونال — كتالوج مواد البناء والحديد والأخشاب
// Prisma schema for SQLite
//
// ملاحظة: SQLite لا يدعم أنواع enum الأصلية ولا النوع Decimal ولا مرشّح
// mode: "insensitive"، لذلك تُخزَّن الحالات والوحدات كسلاسل نصية (String)
// وتُخزَّن المبالغ كأرقام عشرية (Float).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  city         String?
  passwordHash String
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]   @relation("CustomerOrders")
  sentMessages Message[] @relation("SentMessages")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  materials Material[]
}

model Material {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  unit        String   @default("PIECE") // BAG | TON | CUBIC_METER | ...
  price       Float
  minOrderQty Int      @default(1)
  stock       Int?
  imageUrl    String?
  imageData   Bytes?
  imageMime   String?
  isActive    Boolean  @default(true)
  city        String
  region      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([city])
  @@index([isActive])
}

model Order {
  id              String    @id @default(cuid())
  number          String    @unique
  customerId      String
  customer        User      @relation("CustomerOrders", fields: [customerId], references: [id])
  status          String    @default("PENDING") // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  subtotal        Float
  vat             Float
  total           Float
  deliveryCity    String
  deliveryAddress String?
  deliveryDate    DateTime?
  contactPhone    String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items    OrderItem[]
  messages Message[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  name       String
  unit       String
  quantity   Int
  unitPrice  Float
  lineTotal  Float

  @@index([orderId])
}

model Message {
  id         String    @id @default(cuid())
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  body       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([orderId])
}
