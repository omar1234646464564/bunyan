# Local development environment variables
# SQLite database file (created automatically by `npm run db:push`).
DATABASE_URL="file:./dev.db"

# 32+ char random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="dev-only-change-me-please-32-characters-min"
