# Environment variables

# PostgreSQL connection string (e.g. Neon, Supabase, Vercel Postgres).
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bunyan?sslmode=require"

# 32+ char random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="dev-only-change-me-please-32-characters-min"
